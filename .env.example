# Public client config. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Single-restaurant MVP. The server uses this slug; the browser cannot choose a restaurant.
SERVE_RESTAURANT_SLUG=

# Server only. Never import this into client components.
SUPABASE_SERVICE_ROLE_KEY=

